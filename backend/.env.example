# ============================================================
# EvidenceLock - Backend Environment Template
# Copy to .env and fill in real values.
# ============================================================

# ---------- App ----------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------- Database ----------
# PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evidencelock

# ---------- Security ----------
# Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-byte-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- MFA ----------
MFA_ISSUER_NAME=EvidenceLock

# ---------- Storage ----------
UPLOAD_DIR=uploads
REPORT_DIR=reports

# ---------- CORS ----------
# Comma-separated list of allowed origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000